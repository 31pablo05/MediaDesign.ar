---
import '../styles/global.css';

const { title, description, ogImage } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Media Design</title>
  <meta name="description" content={description}>
  
  <!-- Open Graph -->
  <meta property="og:title" content={`${title} | Media Design`}>
  <meta property="og:description" content={description}>
  {ogImage && <meta property="og:image" content={ogImage}>}
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <slot />
</body>
</html>
