---
const items = [
  { text: 'CREAMOS TU MUNDO DIGITAL', color: 'var(--color-cyan)' },
  { text: 'CREAMOS TU MUNDO DIGITAL', color: 'var(--color-magenta)' },
  { text: 'CREAMOS TU MUNDO DIGITAL', color: 'var(--color-purple)' },
  { text: 'CREAMOS TU MUNDO DIGITAL', color: 'var(--color-text-primary)' },
];
---

<div class="marquee-wrap">
  <div class="marquee-track">
    <div class="marquee-group" aria-hidden="false">
      {items.map((item, idx) => (
        <span class="marquee-item">
          <span class="marquee-text" style={`color:${item.color}`}>{item.text}</span>
          <span class="marquee-dot" style={`color:${idx % 2 === 0 ? 'var(--color-magenta)' : 'var(--color-cyan)'}`}>◆</span>
        </span>
      ))}
    </div>
    <div class="marquee-group" aria-hidden="true">
      {items.map((item, idx) => (
        <span class="marquee-item">
          <span class="marquee-text" style={`color:${item.color}`}>{item.text}</span>
          <span class="marquee-dot" style={`color:${idx % 2 === 0 ? 'var(--color-magenta)' : 'var(--color-cyan)'}`}>◆</span>
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee-group {
    display: flex;
    align-items: center;
    gap: 26px;
    padding-right: 26px;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 26px;
  }

  .marquee-text {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 2px;
  }

  .marquee-dot {
    font-size: 18px;
  }
</style>
