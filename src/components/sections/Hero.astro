---
import Button from '../ui/Button.astro';
---

<section id="inicio" class="hero">
  <div class="glow-cyan hero__glow hero__glow--cyan"></div>
  <div class="glow-magenta hero__glow hero__glow--magenta"></div>
  <div class="bg-grid"></div>

  <div class="container">
    <div class="hero-grid">

      <div data-reveal>
        <div class="hero-monitor-mobile lg:hidden">
          <img
            src="/pcmedia.png"
            alt="Media Design — estudio digital"
            class="hero-monitor-mobile__img"
            width="500"
            height="400"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <div class="hero-kicker">ESTUDIO DIGITAL INTEGRAL</div>

        <h1 class="hero-title">
          <span class="hero-heading-line hero-heading-line--big hero-glitch">DISEÑAMOS</span>
          <span class="hero-heading-line hero-heading-line--medium hero-rough">EXPERIENCIAS</span>
          <span class="hero-heading-line hero-heading-line--medium hero-rough">DIGITALES</span>
        </h1>

        <p class="hero-desc">
          <strong class="text-cyan">Diseño</strong> web,
          <strong class="text-cyan"> marcas</strong>,
          <strong class="text-magenta"> redes sociales</strong>,
          <strong class="text-cyan"> contenido</strong> y
          <strong class="text-magenta"> edición profesional</strong>
          para llevar tu marca al siguiente nivel.
        </p>

        <div class="hero-actions">
          <Button label="VER PROYECTOS" href="#portfolio" variant="primary" />
          <Button label="NUESTROS SERVICIOS" href="#servicios" variant="outline" />
        </div>
      </div>

      <div class="hero-visual hidden lg:block" data-reveal data-reveal-delay="2">
        <span class="hero-sticker hero-sticker--warn" aria-hidden="true">
          <span class="hero-sticker__triangle"></span>
          <span class="hero-sticker__bang">!</span>
        </span>

        <span class="hero-sticker hero-sticker--arrow" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M24 30V10"/><path d="M15 19l9-9 9 9"/><path d="M10 34h28"/>
          </svg>
        </span>

        <span class="hero-sticker hero-sticker--cursor hero-sticker--cursor-a" aria-hidden="true"></span>
        <span class="hero-sticker hero-sticker--cursor hero-sticker--cursor-b" aria-hidden="true"></span>
        <span class="hero-sticker hero-sticker--pixel hero-sticker--pixel-magenta" aria-hidden="true"></span>
        <span class="hero-sticker hero-sticker--pixel hero-sticker--pixel-cyan" aria-hidden="true"></span>

        <img
          src="/pcmedia.png"
          alt="Media Design PC"
          class="hero-monitor"
          width="500"
          height="400"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <!-- Stickers simplificados en mobile -->
      <div class="hero-stickers-mobile lg:hidden" aria-hidden="true">
        <span class="hero-sticker hero-sticker--pixel hero-sticker--pixel-magenta"></span>
        <span class="hero-sticker hero-sticker--pixel hero-sticker--pixel-cyan"></span>
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 10;
    background: var(--color-bg);
    overflow: hidden;
    padding: 48px 0 40px;
  }

  .hero__glow--cyan {
    top: -160px;
    right: -120px;
    width: 620px;
    height: 620px;
  }

  .hero__glow--magenta {
    top: 280px;
    left: -140px;
    width: 560px;
    height: 560px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .hero-kicker {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 4px;
    color: var(--color-cyan);
    margin-bottom: 22px;
    text-shadow: 0 0 12px rgba(47, 228, 255, 0.5);
    font-family: var(--font-body);
  }

  .hero-title {
    margin: 0 0 30px;
    line-height: 0.92;
  }

  .hero-heading-line {
    display: block;
    white-space: nowrap;
    font-family: var(--font-display);
  }

  .hero-heading-line--big {
    font-size: 84px;
    letter-spacing: 1px;
    color: var(--color-text-primary);
  }

  .hero-heading-line--medium {
    font-size: 74px;
    letter-spacing: 0.5px;
    color: var(--color-white);
  }

  .hero-glitch {
    animation: mdGlitch 3.2s infinite steps(2);
  }

  .hero-rough {
    filter: url(#rough);
    text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.5);
  }

  .hero-desc {
    max-width: 480px;
    font-size: 21px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-text-body);
    margin-bottom: 38px;
    font-family: var(--font-body);
  }

  .text-cyan { color: var(--color-cyan); font-weight: 700; }
  .text-magenta { color: var(--color-magenta); font-weight: 700; }

  .hero-actions {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero-visual {
    position: relative;
    height: 560px;
  }

  .hero-monitor {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) perspective(1100px) rotateY(-7deg) rotateX(2deg);
    width: 100%;
    max-width: 500px;
    height: auto;
    filter: drop-shadow(0 44px 64px rgba(0, 0, 0, 0.6));
  }

  .hero-monitor-mobile {
    margin: 32px 0;
    text-align: center;
  }

  .hero-monitor-mobile__img {
    width: 100%;
    max-width: clamp(260px, 70vw, 420px);
    filter: drop-shadow(0 44px 64px rgba(0, 0, 0, 0.6));
    display: block;
    margin: 0 auto;
  }

  .hero-sticker {
    position: absolute;
    display: block;
  }

  .hero-sticker--warn {
    left: 32px;
    top: 8px;
    width: 64px;
    height: 64px;
    animation: mdFloatA 5s ease-in-out infinite;
  }

  .hero-sticker__triangle {
    position: absolute;
    inset: 0;
    clip-path: polygon(50% 4%, 96% 92%, 4% 92%);
    background: linear-gradient(#ffd02e, #f4a500);
  }

  .hero-sticker__bang {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    text-align: center;
    font-family: var(--font-display);
    font-size: 24px;
    color: #1a1407;
  }

  .hero-sticker--arrow {
    left: -32px;
    top: 200px;
    color: var(--color-cyan);
    filter: drop-shadow(0 0 6px rgba(47, 228, 255, 0.6));
    animation: mdFloatB 6s ease-in-out infinite;
  }

  .hero-sticker--cursor {
    filter: drop-shadow(2px 3px 2px rgba(0, 0, 0, 0.6));
    clip-path: polygon(0 0, 0 78%, 22% 60%, 36% 95%, 52% 88%, 38% 55%, 64% 55%);
  }

  .hero-sticker--cursor-a {
    right: -6px;
    top: 120px;
    width: 34px;
    height: 42px;
    background: #cfd3dd;
    animation: mdFloatC 5.5s ease-in-out infinite;
  }

  .hero-sticker--cursor-b {
    right: 24px;
    bottom: 24px;
    width: 30px;
    height: 36px;
    background: #e9eaf0;
    animation: mdFloatA 6.5s ease-in-out infinite;
  }

  .hero-sticker--pixel {
    box-shadow: 0 0 10px currentColor;
  }

  .hero-sticker--pixel-magenta {
    right: 120px;
    top: 30px;
    width: 10px;
    height: 10px;
    background: var(--color-magenta);
    color: var(--color-magenta);
  }

  .hero-sticker--pixel-cyan {
    left: 8px;
    bottom: 30px;
    width: 8px;
    height: 8px;
    background: var(--color-cyan);
    color: var(--color-cyan);
  }

  .hero-stickers-mobile {
    position: relative;
    height: 28px;
    margin-top: -12px;
  }

  .hero-stickers-mobile .hero-sticker--pixel-magenta {
    right: 20%;
    top: 0;
  }

  .hero-stickers-mobile .hero-sticker--pixel-cyan {
    left: 18%;
    top: 8px;
    bottom: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glitch {
      animation: none;
      text-shadow: -2px 0 var(--color-cyan), 2px 0 var(--color-magenta);
    }
  }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .hero-heading-line--big {
      font-size: clamp(40px, 9vw, 64px);
      white-space: normal;
    }
    .hero-heading-line--medium {
      font-size: clamp(36px, 8vw, 56px);
      white-space: normal;
    }
    .hero-grid { gap: 28px; }
    .hero-monitor-mobile { margin: 28px 0; }
  }
</style>
