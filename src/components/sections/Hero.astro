---
import GlitchText from '../ui/GlitchText.jsx';
import Button from '../ui/Button.astro';
---

<section id="inicio" class="min-h-screen flex items-center bg-black relative overflow-hidden pt-24 pb-12">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      {/* Mitad Izquierda - Contenido */}
      <div class="space-y-6">
        {/* Etiqueta */}
        <div 
          class="text-xs tracking-widest uppercase"
          style="font-family: var(--font-mono); color: var(--color-cyan); letter-spacing: 0.2em;"
        >
          ESTUDIO DIGITAL INTEGRAL
        </div>

        {/* Título Principal con Glitch */}
        <div class="space-y-1">
          <h1 
            class="text-6xl md:text-7xl lg:text-8xl font-bold leading-none text-white"
            style="font-family: var(--font-display); line-height: 0.9;"
          >
            <div><GlitchText text="DISEÑAMOS" client:load /></div>
            <div><GlitchText text="EXPERIENCIAS" client:load /></div>
            <div><GlitchText text="DIGITALES" client:load /></div>
          </h1>
        </div>

        {/* Descripción */}
        <p class="text-lg md:text-xl leading-relaxed max-w-xl pt-2">
          <span class="text-[var(--color-cyan)]">Diseño</span> web, 
          <span class="text-[var(--color-magenta)]"> marcas</span>, 
          <span class="text-[var(--color-cyan)]"> redes sociales</span>, 
          <span class="text-[var(--color-magenta)]"> contenido</span> y 
          <span class="text-[var(--color-magenta)]"> edición profesional</span> 
          para llevar tu marca al siguiente nivel.
        </p>

        {/* Botones */}
        <div class="flex flex-wrap gap-4 pt-4">
          <Button label="VER PROYECTOS" href="#portfolio" variant="primary" />
          <Button label="NUESTROS SERVICIOS" href="#servicios" variant="outline" />
        </div>
      </div>

      {/* Mitad Derecha - Imagen CRT */}
      <div class="hidden lg:block relative">
        <div class="relative w-full max-w-2xl mx-auto">
          {/* Monitor CRT con imagen real */}
          <img 
            src="/pcmedia.png" 
            alt="Media Design - Computadora retro CRT" 
            class="w-full h-auto"
          />

          {/* Íconos Flotantes */}
          <div class="absolute top-0 right-0 text-4xl animate-[float_3s_ease-in-out_infinite]">
            🖱️
          </div>
          <div class="absolute top-1/4 -left-8 text-3xl animate-[float_4s_ease-in-out_infinite_0.5s]">
            🦖
          </div>
          <div class="absolute top-1/3 -right-8 text-4xl animate-[float_3.5s_ease-in-out_infinite_1s]" style="color: var(--color-magenta);">
            ⚠️
          </div>
          <div class="absolute bottom-1/4 left-0 text-3xl animate-[float_4s_ease-in-out_infinite_1.5s]" style="color: var(--color-cyan);">
            📁
          </div>
          <div class="absolute bottom-10 -right-4 text-4xl animate-[float_3s_ease-in-out_infinite_2s]" style="color: var(--color-cyan);">
            ↗️
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
