---
import Button from '../ui/Button.astro';
---

<section
  id="inicio"
  style="position:relative; z-index:10; background:#07070b; overflow:hidden; padding: 48px 0 40px;"
>
  <!-- Resplandores ambientales -->
  <div style="position:absolute;top:-160px;right:-120px;width:620px;height:620px;border-radius:50%;background:radial-gradient(circle,rgba(47,228,255,.16),transparent 62%);filter:blur(20px);pointer-events:none;"></div>
  <div style="position:absolute;top:280px;left:-140px;width:560px;height:560px;border-radius:50%;background:radial-gradient(circle,rgba(255,58,216,.12),transparent 62%);filter:blur(20px);pointer-events:none;"></div>
  <!-- Grid de fondo -->
  <div style="position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px);background-size:48px 48px;mask-image:radial-gradient(120% 90% at 70% 30%,#000 35%,transparent 80%);-webkit-mask-image:radial-gradient(120% 90% at 70% 30%,#000 35%,transparent 80%);"></div>

  <div class="container">
    <div class="hero-grid">

      <!-- Columna izquierda -->
      <div>
        <div class="hero-monitor-mobile lg:hidden">
          <img
            src="/pcmedia.png"
            alt="Media Design PC"
            class="hero-monitor-mobile__img"
          />
        </div>

        <div style="font-size:15px;font-weight:600;letter-spacing:4px;color:#2fe4ff;margin-bottom:22px;text-shadow:0 0 12px rgba(47,228,255,.5);font-family:'Chakra Petch',sans-serif;">
          ESTUDIO DIGITAL INTEGRAL
        </div>

        <h1 style="margin:0 0 30px; line-height:.92;">
          <!-- Línea 1: animación glitch text-shadow cian/magenta -->
          <span class="hero-heading-line hero-heading-line--big" style="color:#f4f5fa;animation:mdGlitch 3.2s infinite steps(2);">
            DISEÑAMOS
          </span>
          <!-- Líneas 2-3: filtro grunge -->
          <span class="hero-heading-line hero-heading-line--medium" style="color:#fff;filter:url(#rough);text-shadow:3px 3px 0 rgba(0,0,0,.5);">
            EXPERIENCIAS
          </span>
          <span class="hero-heading-line hero-heading-line--medium" style="color:#fff;filter:url(#rough);text-shadow:3px 3px 0 rgba(0,0,0,.5);">
            DIGITALES
          </span>
        </h1>

        <p style="max-width:480px;font-size:21px;font-weight:500;line-height:1.5;color:#e7e9f0;margin-bottom:38px;font-family:'Chakra Petch',sans-serif;">
          <strong style="color:#2fe4ff;font-weight:700;">Diseño</strong> web,
          <strong style="color:#2fe4ff;font-weight:700;"> marcas</strong>,
          <strong style="color:#ff3ad8;font-weight:700;"> redes sociales</strong>,
          <strong style="color:#2fe4ff;font-weight:700;"> contenido</strong> y
          <strong style="color:#ff3ad8;font-weight:700;"> edición profesional</strong>
          para llevar tu marca al siguiente nivel.
        </p>

        <div style="display:flex;gap:18px;flex-wrap:wrap;align-items:center;">
          <Button label="VER PROYECTOS"      href="#portfolio"  variant="primary" />
          <Button label="NUESTROS SERVICIOS" href="#servicios"  variant="outline" />
        </div>
      </div>

      <!-- Columna derecha: monitor CRT + stickers flotantes -->
      <div class="hidden lg:block" style="position:relative; height:560px;">

        <!-- Sticker triángulo advertencia -->
        <span style="position:absolute;left:32px;top:8px;width:64px;height:64px;animation:mdFloatA 5s ease-in-out infinite;display:block;">
          <span style="position:absolute;inset:0;clip-path:polygon(50% 4%,96% 92%,4% 92%);background:linear-gradient(#ffd02e,#f4a500);display:block;"></span>
          <span style="position:absolute;left:0;right:0;bottom:14px;text-align:center;font-family:'Anton',sans-serif;font-size:24px;color:#1a1407;">!</span>
        </span>

        <!-- Sticker flecha cian SVG -->
        <span style="position:absolute;left:-32px;top:200px;animation:mdFloatB 6s ease-in-out infinite;display:block;">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="#2fe4ff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="filter:drop-shadow(0 0 6px rgba(47,228,255,.6));">
            <path d="M24 30V10"/><path d="M15 19l9-9 9 9"/><path d="M10 34h28"/>
          </svg>
        </span>

        <!-- Sticker cursor blanco -->
        <span style="position:absolute;right:-6px;top:120px;width:34px;height:42px;background:#cfd3dd;filter:drop-shadow(2px 3px 2px rgba(0,0,0,.6));clip-path:polygon(0 0,0 78%,22% 60%,36% 95%,52% 88%,38% 55%,64% 55%);animation:mdFloatC 5.5s ease-in-out infinite;display:block;"></span>

        <!-- Sticker cursor gris bottom-right -->
        <span style="position:absolute;right:24px;bottom:24px;width:30px;height:36px;background:#e9eaf0;filter:drop-shadow(2px 3px 2px rgba(0,0,0,.6));clip-path:polygon(0 0,0 78%,22% 60%,36% 95%,52% 88%,38% 55%,64% 55%);animation:mdFloatA 6.5s ease-in-out infinite;display:block;"></span>

        <!-- Pixel magenta y cian -->
        <span style="position:absolute;right:120px;top:30px;width:10px;height:10px;background:#ff3ad8;box-shadow:0 0 10px #ff3ad8;display:block;"></span>
        <span style="position:absolute;left:8px;bottom:30px;width:8px;height:8px;background:#2fe4ff;box-shadow:0 0 10px #2fe4ff;display:block;"></span>

        <!-- Monitor PC imagen -->
        <img 
          src="/pcmedia.png" 
          alt="Media Design PC"
          style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) perspective(1100px) rotateY(-7deg) rotateX(2deg);width:100%;max-width:500px;height:auto;filter:drop-shadow(0 44px 64px rgba(0,0,0,.6));"
        />

      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0,1.08fr) minmax(0,1fr);
    gap: 40px;
    align-items: center;
  }

  .hero-heading-line {
    display: block;
    white-space: nowrap;
    font-family: 'Anton', sans-serif;
  }

  .hero-heading-line--big {
    font-size: 84px;
    letter-spacing: 1px;
  }

  .hero-heading-line--medium {
    font-size: 74px;
    letter-spacing: .5px;
  }

  .hero-monitor-mobile {
    margin-top: 32px;
    margin-bottom: 32px;
    text-align: center;
  }

  .hero-monitor-mobile__img {
    width: 100%;
    max-width: clamp(260px, 70vw, 420px);
    height: auto;
    filter: drop-shadow(0 44px 64px rgba(0,0,0,.6));
    display: block;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .hero-heading-line--big {
      font-size: clamp(40px, 9vw, 64px);
      white-space: normal;
    }
    .hero-heading-line--medium {
      font-size: clamp(36px, 8vw, 56px);
      white-space: normal;
    }
    .hero-grid {
      gap: 28px;
    }
    .hero-monitor-mobile {
      margin-top: 28px;
      margin-bottom: 28px;
    }
    .hero-monitor-mobile__img {
      max-width: clamp(240px, 75vw, 380px);
    }
  }
</style>

