---
import ServiceCard from '../ui/ServiceCard.astro';
---

<section id="servicios" class="section-padding" style="background:var(--color-bg);">
  <div class="container">

    <div class="section-header section-header--center" data-reveal>
      <span class="section-kicker">// 01 — SERVICIOS</span>
      <h2 class="section-title section-title--center">
        SOLUCIONES CREATIVAS<br>PARA TU MARCA.
      </h2>
    </div>

    <div class="row-3">
      <div class="wrap" data-reveal data-reveal-delay="1"><ServiceCard icon="web" title="DISEÑO WEB" description="Sitios modernos, rápidos y adaptados a tu marca." /></div>
      <div class="wrap" data-reveal data-reveal-delay="2"><ServiceCard icon="landing" title="LANDING PAGES" description="Páginas de aterrizaje optimizadas para conversión." /></div>
      <div class="wrap" data-reveal data-reveal-delay="3"><ServiceCard icon="ecommerce" title="TIENDAS ONLINE" description="E-commerce funcional y atractivo para vender más." /></div>
    </div>

    <div class="row-4">
      <div data-reveal data-reveal-delay="1"><ServiceCard icon="redes" title="GESTIÓN DE REDES" description="Estrategia, contenido y gestión de redes sociales." /></div>
      <div data-reveal data-reveal-delay="2"><ServiceCard icon="grafico" title="DISEÑO GRÁFICO" description="Piezas visuales que comunican tu mensaje." /></div>
      <div data-reveal data-reveal-delay="3"><ServiceCard icon="branding" title="BRANDING" description="Identidad visual y posicionamiento de marca." /></div>
      <div data-reveal data-reveal-delay="4"><ServiceCard icon="audiovisual" title="CONTENIDO AUDIOVISUAL" description="Videos, reels y producciones de alto impacto." /></div>
    </div>

  </div>
</section>

<style>
  .row-3 {
    display: flex;
    justify-content: center;
    gap: 22px;
    margin-bottom: 22px;
  }

  .wrap {
    flex: 0 0 calc(25% - 16.5px);
    min-width: 0;
  }

  .row-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  @media (max-width: 1024px) {
    .row-3 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
    .wrap { flex: unset; }
    .row-4 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .row-3,
    .row-4 { grid-template-columns: 1fr; }
  }
</style>
