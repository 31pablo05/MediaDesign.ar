---
import ContactForm from '../ui/ContactForm';
---

<section id="contacto" class="section-padding contact-section">
  <div class="container">
    <div class="contact-grid">

      <!-- Izquierda — info de contacto -->
      <div class="contact-info">
        <span class="section-kicker contact-kicker">// 04 — CONTACTO</span>

        <h2 class="section-title contact-title">
          HABLEMOS DE<br>TU PROYECTO.
        </h2>

        <p class="contact-copy">
          ¿Tenés una idea en mente? Contanos qué necesitás y te respondemos en menos de 24 horas.
        </p>

        <div class="contact-actions">
          <a
            href="https://wa.me/5492805123541"
            target="_blank"
            rel="noopener"
            class="contact-link"
          >
            <span class="contact-icon contact-icon--success">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#57ff7a" stroke-width="2">
                <path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.6A8.5 8.5 0 1 1 21 11.5z"/>
              </svg>
            </span>
            <span class="contact-link-label">280-5 12 35 41</span>
          </a>

          <a
            href="https://instagram.com/mediadesign.ar"
            target="_blank"
            rel="noopener"
            class="contact-link"
          >
            <span class="contact-icon contact-icon--accent">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ff3ad8" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="1" fill="#ff3ad8" stroke="none"/>
              </svg>
            </span>
            <span class="contact-link-label">@mediadesign.ar</span>
          </a>

          <p class="contact-note">
            Respondemos de lunes a viernes de 9:00 a 18:00 hs (GMT-3)
          </p>
        </div>
      </div>

      <!-- Derecha — formulario (React island) -->
      <ContactForm client:load />

    </div>
  </div>
</section>

<style>
  .contact-section {
    background: var(--color-bg);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 56px;
    align-items: start;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .contact-kicker {
    color: var(--color-purple);
  }

  .contact-title {
    margin: 12px 0 22px;
  }

  .contact-copy {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 480px;
    margin: 0;
    font-family: var(--font-body);
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--color-white);
    transition: color 0.2s ease;
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    color: var(--color-cyan);
  }

  .contact-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    flex-shrink: 0;
  }

  .contact-icon--success {
    border: 1px solid rgba(87, 255, 122, 0.4);
    background: rgba(87, 255, 122, 0.08);
  }

  .contact-icon--accent {
    border: 1px solid rgba(255, 58, 216, 0.4);
    background: rgba(255, 58, 216, 0.08);
  }

  .contact-link-label {
    font-size: 15.5px;
    font-weight: 500;
    font-family: var(--font-body);
  }

  .contact-note {
    margin-top: 8px;
    font-size: 13px;
    color: var(--color-dim);
    font-family: var(--font-body);
  }

  @media (max-width: 1024px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
