---
---

<section id="contacto" class="section-padding bg-[var(--color-bg-deep)]">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl mx-auto text-center">
      {/* Encabezado */}
      <div 
        class="text-xs tracking-widest mb-4 uppercase"
        style="font-family: var(--font-mono); color: var(--color-cyan); letter-spacing: 0.2em;"
      >
        HABLEMOS DE TU PROYECTO
      </div>
      
      <h2 
        class="text-5xl md:text-6xl font-bold mb-12"
        style="font-family: var(--font-display);"
      >
        ¿HABLAMOS?
      </h2>

      {/* Botones de Contacto */}
      <div class="flex flex-col sm:flex-row gap-6 justify-center mb-8">
        {/* WhatsApp */}
        <a
          href="https://wa.me/5492805123541"
          target="_blank"
          class="flex items-center justify-center gap-3 px-8 py-4 rounded-lg border-2 transition-all duration-300 hover:-translate-y-1"
          style="border-color: var(--color-cyan); background: transparent;"
        >
          <span class="text-3xl">📱</span>
          <div class="text-left">
            <div class="text-xs text-[var(--color-muted)] uppercase" style="font-family: var(--font-mono);">
              WhatsApp
            </div>
            <div class="text-lg font-bold" style="font-family: var(--font-mono); color: var(--color-cyan);">
              280-5 12 35 41
            </div>
          </div>
        </a>

        {/* Instagram */}
        <a
          href="https://instagram.com/mediadesign.ar"
          target="_blank"
          class="flex items-center justify-center gap-3 px-8 py-4 rounded-lg border-2 transition-all duration-300 hover:-translate-y-1"
          style="border-color: var(--color-magenta); background: transparent;"
        >
          <span class="text-3xl">📸</span>
          <div class="text-left">
            <div class="text-xs text-[var(--color-muted)] uppercase" style="font-family: var(--font-mono);">
              Instagram
            </div>
            <div class="text-lg font-bold" style="font-family: var(--font-mono); color: var(--color-magenta);">
              @mediadesign.ar
            </div>
          </div>
        </a>
      </div>

      {/* Texto adicional */}
      <p class="text-sm text-[var(--color-muted)]" style="font-family: var(--font-mono);">
        Respondemos de lunes a viernes de 9:00 a 18:00 hs (GMT-3)
      </p>
    </div>
  </div>
</section>
