---
const projects = [
  {
    id: 1,
    title: 'Proyecto Web',
    category: 'WEB',
    categoryColor: 'var(--color-cyan)',
    image: '/trabajos/23.png',
    url: 'https://instagram.com/mediadesign.ar',
    featured: true,
  },
  {
    id: 2,
    title: 'Identidad Visual',
    category: 'BRANDING',
    categoryColor: 'var(--color-magenta)',
    image: '/trabajos/19.png',
    url: 'https://instagram.com/mediadesign.ar',
  },
  {
    id: 3,
    title: 'Campaña Social',
    category: 'REDES',
    categoryColor: 'var(--color-purple)',
    image: '/trabajos/20.png',
    displayCategory: 'PROYECTOS INSTITUCIONALES',
    url: 'https://instagram.com/mediadesign.ar',
  },
  {
    id: 4,
    title: 'Video Corporativo',
    category: 'AUDIOVISUAL',
    categoryColor: 'var(--color-cyan)',
    video: '/trabajos/videoinsti.mp4',
    url: 'https://instagram.com/mediadesign.ar',
  },
  {
    id: 5,
    title: 'Landing Page',
    category: 'WEB',
    categoryColor: 'var(--color-magenta)',
    image: '/trabajos/21.png',
    url: 'https://instagram.com/mediadesign.ar',
  },
  {
    id: 6,
    title: 'Contenido Digital',
    category: 'REDES',
    categoryColor: 'var(--color-purple)',
    image: '/trabajos/22.png',
    url: 'https://instagram.com/mediadesign.ar',
  },
];

const filters = ['TODOS', 'WEB', 'BRANDING', 'REDES', 'AUDIOVISUAL'];
---

<section id="portfolio" class="section-padding portfolio-section">
  <div class="container">

    <div class="section-header section-header--split" data-reveal>
      <div>
        <span class="section-kicker">// 02 — PROYECTOS</span>
        <h2 class="section-title">TRABAJOS<br>RECIENTES</h2>
      </div>

      <div class="portfolio-filters" id="portfolio-filters" role="group" aria-label="Filtrar proyectos">
        {filters.map((f, idx) => (
          <button
            type="button"
            class={`filter-chip${idx === 0 ? ' is-active' : ''}`}
            data-filter={f}
          >
            {f}
          </button>
        ))}
      </div>
    </div>

    <div class="portfolio-grid" id="portfolio-grid">
      {projects.map((p, idx) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          class={`project-card${p.featured ? ' project-card--featured' : ''}`}
          data-category={p.category}
          data-reveal
          data-reveal-delay={String((idx % 6) + 1)}
          style={`--project-color: ${p.categoryColor}`}
        >
          <div class="project-image">
            {p.video ? (
              <video
                class="project-image__media project-image__video"
                src={p.video}
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={`Video: ${p.title}`}
              />
            ) : (
              <img
                src={p.image}
                alt={p.title}
                class="project-image__media"
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
              />
            )}
            <div class="project-overlay">
              <span class="project-overlay__cta">VER PROYECTO →</span>
            </div>
          </div>
          <div class="project-body">
            <span class="project-category">
              {p.displayCategory ?? p.category}
            </span>
            <h3 class="project-title">{p.title}</h3>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<script>
  const grid = document.getElementById('portfolio-grid');
  const filtersEl = document.getElementById('portfolio-filters');

  filtersEl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.filter-chip') as HTMLButtonElement | null;
    if (!btn) return;

    const selected = btn.dataset.filter ?? 'TODOS';

    filtersEl.querySelectorAll('.filter-chip').forEach((chip) => {
      chip.classList.toggle('is-active', chip === btn);
    });

    grid?.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
      const category = card.dataset.category ?? '';
      const match = selected === 'TODOS' || category === selected;
      card.style.display = match ? '' : 'none';
    });
  });
</script>

<style>
  .portfolio-filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .portfolio-filters {
      justify-content: center;
      width: 100%;
    }
  }
</style>
