---
---

<section id="nosotros" class="section-padding bg-black">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      {/* Columna Izquierda - Texto */}
      <div class="space-y-6">
        <div 
          class="text-xs tracking-widest uppercase"
          style="font-family: var(--font-mono); color: var(--color-cyan); letter-spacing: 0.2em;"
        >
          SOBRE NOSOTROS
        </div>
        
        <h2 
          class="text-4xl md:text-5xl font-bold"
          style="font-family: var(--font-display);"
        >
          SOMOS<br/>MEDIA DESIGN
        </h2>

        <p class="text-lg leading-relaxed text-[var(--color-muted)]">
          Un estudio digital integral fundado en <span class="text-white">Trelew, Patagonia, Argentina</span> 
          por <span class="text-[var(--color-cyan)]">Yamila Almendra</span> y 
          <span class="text-[var(--color-magenta)]"> Pablo Proboste</span>. 
          Combinamos creatividad, técnica y pasión por el diseño para transformar ideas en experiencias digitales únicas.
        </p>

        <p class="text-lg leading-relaxed text-[var(--color-muted)]">
          Desde sitios web modernos hasta estrategias de contenido, nos especializamos en llevar 
          tu marca al siguiente nivel con soluciones personalizadas y profesionales.
        </p>

        {/* Stats */}
        <div class="grid grid-cols-3 gap-6 pt-6">
          <div class="text-center">
            <div 
              class="text-4xl font-bold mb-2"
              style="font-family: var(--font-display); color: var(--color-cyan);"
            >
              50+
            </div>
            <div class="text-sm text-[var(--color-muted)]" style="font-family: var(--font-mono);">
              Clientes
            </div>
          </div>
          <div class="text-center">
            <div 
              class="text-4xl font-bold mb-2"
              style="font-family: var(--font-display); color: var(--color-magenta);"
            >
              100+
            </div>
            <div class="text-sm text-[var(--color-muted)]" style="font-family: var(--font-mono);">
              Proyectos
            </div>
          </div>
          <div class="text-center">
            <div 
              class="text-4xl font-bold mb-2"
              style="font-family: var(--font-display); color: var(--color-cyan);"
            >
              5+
            </div>
            <div class="text-sm text-[var(--color-muted)]" style="font-family: var(--font-mono);">
              Años
            </div>
          </div>
        </div>
      </div>

      {/* Columna Derecha - Fotos del Equipo */}
      <div class="grid grid-cols-2 gap-6">
        {/* Yamila */}
        <div class="text-center">
          <div 
            class="aspect-square bg-[var(--color-surface)] rounded-lg border-2 mb-4 flex items-center justify-center overflow-hidden"
            style="border-color: var(--color-cyan);"
          >
            <div class="text-6xl">👩‍💻</div>
          </div>
          <h3 class="text-xl font-bold mb-1" style="font-family: var(--font-display);">
            Yamila Almendra
          </h3>
          <p class="text-sm" style="font-family: var(--font-mono); color: var(--color-cyan);">
            Diseñadora & Creativa
          </p>
        </div>

        {/* Pablo */}
        <div class="text-center">
          <div 
            class="aspect-square bg-[var(--color-surface)] rounded-lg border-2 mb-4 flex items-center justify-center overflow-hidden"
            style="border-color: var(--color-magenta);"
          >
            <div class="text-6xl">👨‍💻</div>
          </div>
          <h3 class="text-xl font-bold mb-1" style="font-family: var(--font-display);">
            Pablo Proboste
          </h3>
          <p class="text-sm" style="font-family: var(--font-mono); color: var(--color-magenta);">
            Developer & Audiovisual
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
