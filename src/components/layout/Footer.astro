---
---

<footer class="site-footer">
  <div class="footer-glow footer-glow--cyan"></div>
  <div class="footer-glow footer-glow--magenta"></div>
  
  <div class="container">

    <div class="footer-main">

      <div class="footer-brand">
        <a 
          href="/" 
          class="footer-logo-badge"
          aria-label="Media Design — Inicio"
        >
          {/* Borde gradiente */}
          <span class="footer-logo-border"></span>
          
          {/* Contenido del logo */}
          <div class="footer-logo-content">
            <span class="footer-logo-text footer-logo-media">MEDIA</span>
            <span class="footer-logo-text footer-logo-design">DESIGN</span>
            {/* Línea divisora gradiente */}
            <span class="footer-logo-divider"></span>
            {/* Subtítulo */}
            <span class="footer-logo-subtitle">ESTUDIO DIGITAL INTEGRAL</span>
          </div>
        </a>
        
        <span class="footer-tagline">
          Estudio digital integral.<br />
          Trelew, Patagonia, Argentina.
        </span>
        
        <div class="footer-social">
          <a href="https://instagram.com/mediadesign.ar" target="_blank" rel="noopener" class="footer-social-link" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="https://wa.me/5492804512345" target="_blank" rel="noopener" class="footer-social-link" aria-label="WhatsApp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </a>
        </div>
      </div>

      <nav class="footer-nav" aria-label="Enlaces del pie de página">
        <div class="footer-col">
          <span class="footer-col__title">NAVEGACIÓN</span>
          <a href="/#inicio" class="footer-link">Inicio</a>
          <a href="/#servicios" class="footer-link">Servicios</a>
          <a href="/#portfolio" class="footer-link">Proyectos</a>
        </div>
        <div class="footer-col">
          <span class="footer-col__title">MÁS</span>
          <a href="/#nosotros" class="footer-link">Sobre nosotros</a>
          <a href="/#contacto" class="footer-link">Contacto</a>
          <a href="/blog" class="footer-link">Blog</a>
        </div>
      </nav>

    </div>

    <div class="footer-bottom">
      <span>© 2026 Media Design — Todos los derechos reservados.</span>
      <span class="footer-credits">Hecho con <span class="footer-heart">♥</span> pixeles y café.</span>
    </div>

  </div>
</footer>

<style>
  /* ===== KEYFRAMES ===== */
  @keyframes footerGlow {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }
  
  @keyframes footerLogoFloat {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-4px); }
  }
  
  @keyframes heartBeat {
    0%, 100% { transform: scale(1); }
    25% { transform: scale(1.2); }
    50% { transform: scale(1); }
  }
  
  @keyframes linkSlideIn {
    from { 
      opacity: 0; 
      transform: translateX(-8px); 
    }
    to { 
      opacity: 1; 
      transform: translateX(0); 
    }
  }

  /* ===== FOOTER BASE ===== */
  .site-footer {
    position: relative;
    z-index: 10;
    border-top: 1px solid rgba(47, 228, 255, 0.15);
    background: linear-gradient(180deg, #0a0a10 0%, #07070b 100%);
    overflow: hidden;
    box-shadow: 
      0 -8px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(47, 228, 255, 0.1);
  }
  
  .footer-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
    opacity: 0.4;
    animation: footerGlow 6s ease-in-out infinite;
  }
  
  .footer-glow--cyan {
    top: -250px;
    left: -100px;
    background: radial-gradient(circle, rgba(47, 228, 255, 0.2), transparent 70%);
  }
  
  .footer-glow--magenta {
    bottom: -250px;
    right: -100px;
    background: radial-gradient(circle, rgba(255, 58, 216, 0.15), transparent 70%);
    animation-delay: 3s;
  }

  /* ===== FOOTER LAYOUT ===== */
  .footer-main {
    padding: 64px 0 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  /* ===== LOGO BADGE EN FOOTER ===== */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 280px;
  }
  
  .footer-logo-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 12px 16px;
    border-radius: 12px;
    background: linear-gradient(160deg, #0c0c14, #08080e);
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation: footerLogoFloat 4s ease-in-out infinite;
    box-shadow: 
      0 8px 24px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    width: fit-content;
  }
  
  .footer-logo-badge:hover {
    transform: scale(1.05) translateY(-4px);
    animation-play-state: paused;
    box-shadow: 
      0 12px 32px rgba(47, 228, 255, 0.3),
      0 0 40px rgba(255, 58, 216, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
  
  .footer-logo-border {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    padding: 2px;
    background: linear-gradient(135deg, #2fe4ff, #9d5cff, #ff3ad8);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }
  
  .footer-logo-badge:hover .footer-logo-border {
    opacity: 1;
  }
  
  .footer-logo-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  
  .footer-logo-text {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--color-white);
    letter-spacing: 2px;
    line-height: 1;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }
  
  .footer-logo-media {
    line-height: 1;
  }
  
  .footer-logo-design {
    line-height: 0.92;
    filter: url(#rough);
  }
  
  .footer-logo-badge:hover .footer-logo-text {
    color: var(--color-cyan);
    text-shadow: 
      0 0 20px rgba(47, 228, 255, 0.6),
      0 0 40px rgba(255, 58, 216, 0.4);
  }
  
  .footer-logo-divider {
    display: block;
    width: 100%;
    height: 1.5px;
    background: linear-gradient(90deg, #2fe4ff, #9d5cff, #ff3ad8);
    margin: 7px 0 6px;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }
  
  .footer-logo-badge:hover .footer-logo-divider {
    opacity: 1;
    box-shadow: 0 0 8px rgba(47, 228, 255, 0.6);
  }
  
  .footer-logo-subtitle {
    font-size: 8.5px;
    letter-spacing: 1.8px;
    color: #2fe4ff;
    font-family: var(--font-body);
    white-space: nowrap;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }
  
  .footer-logo-badge:hover .footer-logo-subtitle {
    color: #ff3ad8;
  }

  /* ===== TAGLINE ===== */
  .footer-tagline {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
    font-family: var(--font-body);
    transition: color 0.3s ease;
  }
  
  .footer-brand:hover .footer-tagline {
    color: var(--color-text-secondary);
  }

  /* ===== SOCIAL LINKS ===== */
  .footer-social {
    display: flex;
    gap: 12px;
    margin-top: 4px;
  }
  
  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(47, 228, 255, 0.05);
    border: 1px solid rgba(47, 228, 255, 0.2);
    color: var(--color-cyan);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    text-decoration: none;
  }
  
  .footer-social-link:hover {
    background: rgba(47, 228, 255, 0.15);
    border-color: var(--color-cyan);
    color: var(--color-white);
    transform: translateY(-4px) scale(1.05);
    box-shadow: 
      0 8px 20px rgba(47, 228, 255, 0.3),
      0 0 30px rgba(47, 228, 255, 0.2);
  }
  
  .footer-social-link:nth-child(2):hover {
    background: rgba(255, 58, 216, 0.15);
    border-color: var(--color-magenta);
    color: var(--color-magenta);
    box-shadow: 
      0 8px 20px rgba(255, 58, 216, 0.3),
      0 0 30px rgba(255, 58, 216, 0.2);
  }

  /* ===== NAVEGACIÓN ===== */
  .footer-nav {
    display: flex;
    gap: 72px;
    flex-wrap: wrap;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-col__title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--color-cyan);
    margin-bottom: 4px;
    font-family: var(--font-body);
    position: relative;
    padding-bottom: 8px;
  }
  
  .footer-col__title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-cyan), transparent);
    border-radius: 2px;
  }

  .footer-link {
    font-size: 14px;
    color: var(--color-nav);
    text-decoration: none;
    font-family: var(--font-body);
    transition: all 0.25s ease;
    padding-left: 0;
    position: relative;
    display: inline-block;
    width: fit-content;
  }
  
  .footer-link::before {
    content: '→';
    position: absolute;
    left: -18px;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    color: var(--color-cyan);
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--color-white);
    padding-left: 18px;
    text-shadow: 0 0 8px rgba(47, 228, 255, 0.3);
  }
  
  .footer-link:hover::before {
    opacity: 1;
    transform: translateX(0);
  }

  /* ===== FOOTER BOTTOM ===== */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 48px;
    padding: 24px 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--color-dim);
    font-family: var(--font-body);
    position: relative;
    z-index: 1;
  }
  
  .footer-credits {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  
  .footer-heart {
    display: inline-block;
    color: var(--color-magenta);
    animation: heartBeat 2s ease-in-out infinite;
    font-size: 16px;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .footer-main {
      padding: 48px 0 0;
      gap: 36px;
    }
    
    .footer-brand {
      max-width: 100%;
    }
    
    .footer-logo-badge {
      padding: 10px 13px;
    }
    
    .footer-logo-text {
      font-size: 24px;
    }
    
    .footer-logo-subtitle {
      font-size: 7.5px;
      letter-spacing: 1.5px;
    }
    
    .footer-nav {
      gap: 48px;
      width: 100%;
    }
    
    .footer-col {
      flex: 1;
      min-width: 140px;
    }
    
    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: 8px;
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    
    .footer-logo-badge {
      animation: none;
    }
    
    .footer-glow {
      animation: none;
    }
    
    .footer-heart {
      animation: none;
    }
  }
</style>
