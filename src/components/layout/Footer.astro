---
---

<footer class="bg-[var(--color-bg-deep)] border-t border-[var(--color-cyan)]/20 mt-20">
  <div class="container mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      {/* Columna Izquierda - Logo e Info */}
      <div>
        <div class="mb-4">
          <img 
            src="/logo2.jpeg" 
            alt="Media Design - Estudio Digital Integral" 
            class="h-16 w-auto mb-2"
          />
        </div>
        <p class="text-xs text-[var(--color-muted)] mt-4" style="font-family: var(--font-mono);">
          Trelew · Patagonia · Argentina
        </p>
      </div>

      {/* Columna Central - Links */}
      <div>
        <h4 class="text-sm font-bold mb-4 text-white" style="font-family: var(--font-body);">
          Navegación
        </h4>
        <ul class="space-y-2">
          <li>
            <a href="#servicios" class="text-sm text-[var(--color-muted)] hover:text-white transition-colors">
              Servicios
            </a>
          </li>
          <li>
            <a href="#nosotros" class="text-sm text-[var(--color-muted)] hover:text-white transition-colors">
              Nosotros
            </a>
          </li>
          <li>
            <a href="#portfolio" class="text-sm text-[var(--color-muted)] hover:text-white transition-colors">
              Portfolio
            </a>
          </li>
          <li>
            <a href="#contacto" class="text-sm text-[var(--color-muted)] hover:text-white transition-colors">
              Contacto
            </a>
          </li>
        </ul>
      </div>

      {/* Columna Derecha - Contacto */}
      <div>
        <h4 class="text-sm font-bold mb-4 text-white" style="font-family: var(--font-body);">
          Contacto
        </h4>
        <div class="space-y-2">
          <a 
            href="https://wa.me/5492805123541" 
            target="_blank"
            class="flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-white transition-colors"
          >
            <span>📱</span>
            <span>280-5 12 35 41</span>
          </a>
          <a 
            href="https://instagram.com/mediadesign.ar" 
            target="_blank"
            class="flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-white transition-colors"
          >
            <span>📸</span>
            <span>@mediadesign.ar</span>
          </a>
        </div>
      </div>
    </div>

    {/* Línea Divisoria */}
    <div class="border-t border-white/10 pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-[var(--color-muted)]" style="font-family: var(--font-mono);">
        © 2026 Yamila Almendra · Pablo Proboste
      </p>
      <p 
        class="text-xs" 
        style="font-family: var(--font-mono); color: var(--color-cyan); opacity: 0.5;"
      >
        ⚡ hecho por nosotros
      </p>
    </div>
  </div>
</footer>
