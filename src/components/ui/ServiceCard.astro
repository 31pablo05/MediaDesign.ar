---
const { icon, title, description } = Astro.props;

const icons: Record<string, string> = {
  web: `<svg width="54" height="54" viewBox="0 0 48 48" fill="none" stroke="url(#ig)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="6" y="9" width="36" height="29" rx="3"/>
    <path d="M6 17h36"/>
    <circle cx="11" cy="13" r=".9" fill="url(#ig)"/>
    <circle cx="15" cy="13" r=".9" fill="url(#ig)"/>
    <path d="M28 33l7-7 4 4-7 7-5 1z"/>
  </svg>`,

  landing: `<svg width="54" height="54" viewBox="0 0 48 48" fill="none" stroke="url(#ig)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="10" y="6" width="28" height="36" rx="3"/>
    <path d="M16 14h16M16 20h16M16 26h10"/>
  </svg>`,

  ecommerce: `<svg width="54" height="54" viewBox="0 0 48 48" fill="none" stroke="url(#ig)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8 8h4l3 18h18l3-12H15"/>
    <circle cx="20" cy="34" r="2" fill="url(#ig)" stroke="none"/>
    <circle cx="30" cy="34" r="2" fill="url(#ig)" stroke="none"/>
  </svg>`,

  redes: `<svg width="54" height="54" viewBox="0 0 48 48" fill="none" stroke="url(#ig)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="15" y="6" width="18" height="36" rx="3"/>
    <path d="M21 38h6"/>
    <path d="M24 24c-2-2.4-6-1.1-6 1.8 0 2.6 6 6 6 6s6-3.4 6-6c0-2.9-4-4.2-6-1.8z"/>
  </svg>`,

  grafico: `<svg width="54" height="54" viewBox="0 0 48 48" fill="none" stroke="url(#ig)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M24 7l13 31-13-6-13 6z"/>
    <rect x="21" y="5" width="6" height="6" rx="1"/>
    <rect x="33" y="34" width="6" height="6" rx="1"/>
    <rect x="9" y="34" width="6" height="6" rx="1"/>
  </svg>`,

  branding: `<svg width="54" height="54" viewBox="0 0 48 48" fill="none" stroke="url(#ig)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M24 6l4.5 9 10 1.5-7.2 7 1.7 10L24 29l-9 4.5 1.7-10L9.5 16.5l10-1.5z"/>
  </svg>`,

  audiovisual: `<svg width="54" height="54" viewBox="0 0 48 48" fill="none" stroke="url(#ig)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="7" y="18" width="34" height="22" rx="2"/>
    <path d="M7 18l33-4-1-6-33 4z"/>
    <path d="M14 11l-3 7M22 9l-3 7M30 8l-3 7M38 7l-3 7"/>
  </svg>`,
};

const svgIcon = icons[icon] ?? icons['web'];
---

<div class="service-card">
  <div class="icon-wrapper" set:html={svgIcon} />
  <h3 class="service-title">{title}</h3>
  <p class="service-desc">{description}</p>
</div>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 32px 22px;
    border-radius: 8px;
    background: linear-gradient(160deg, #14151b, #0b0b10);
    border: 1px solid rgba(255,255,255,.06);
    transition: transform .25s, border-color .25s, box-shadow .25s;
  }

  .service-card:hover {
    transform: translateY(-7px);
    border-color: rgba(47,228,255,.5);
    box-shadow: 0 18px 40px rgba(0,0,0,.5), 0 0 22px rgba(47,228,255,.12);
  }

  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .service-title {
    font-family: 'Chakra Petch', sans-serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #fff;
  }

  .service-desc {
    font-family: 'Chakra Petch', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #9aa0ad;
  }
</style>
