---
const { icon, title, description } = Astro.props;
---

<div class="service-card bg-[var(--color-surface)] border border-white/5 rounded-[var(--radius)] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-cyan)] group">
  <div class="icon-wrapper w-16 h-16 mx-auto mb-6 bg-black border border-[var(--color-cyan)]/20 rounded-lg flex items-center justify-center text-3xl group-hover:border-[var(--color-cyan)] transition-all duration-300" style="box-shadow: 0 0 0 rgba(0,255,255,0);">
    {icon}
  </div>
  <h3 class="text-xl font-bold mb-3 text-white" style="font-family: var(--font-display);">
    {title}
  </h3>
  <p class="text-[var(--color-muted)]" style="font-family: var(--font-body);">
    {description}
  </p>
</div>

<style>
  .service-card:hover {
    box-shadow: 
      0 0 5px rgba(0, 255, 255, 0.4),
      0 0 10px rgba(0, 255, 255, 0.3),
      0 0 20px rgba(0, 255, 255, 0.2),
      0 0 40px rgba(0, 255, 255, 0.1);
  }
  
  .service-card:hover .icon-wrapper {
    box-shadow: 
      0 0 10px rgba(0, 255, 255, 0.5),
      0 0 20px rgba(0, 255, 255, 0.3);
  }
</style>
